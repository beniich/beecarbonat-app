generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("ENTERPRISE") // FREE, PRO, ENTERPRISE
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  buildings         Building[]
  assets            Asset[]
  procedures        Procedure[]
  parts             Part[]
  failureCodes      FailureCode[]
  digitalTwins      DigitalTwin[]
  notifications     Notification[]
  tenantConfigs     TenantConfig[]
  tenantDomains     TenantDomain[]
  erpConnections    ERPConnection[]
  bimModels         BIMModel[]
  tickets           Ticket[]
  slaPolicies       SLAPolicy[]
  assetQRCodes      AssetQRCode[]
}

model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         String   @default("VIEWER")
  department   String?
  avatar       String?
  isActive     Boolean  @default(true)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrders        WorkOrder[]               @relation("AssignedTo")
  createdWOs        WorkOrder[]               @relation("CreatedBy")
  assets            Asset[]
  comments          Comment[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  notificationPref  NotificationPreference?
  inventoryMovements InventoryMovement[]
  submittedTickets   Ticket[]                  @relation("SubmittedTickets")
  validatedTickets   Ticket[]                  @relation("ValidatedTickets")
  assignedTickets    Ticket[]                  @relation("AssignedTickets")
  closedTickets      Ticket[]                  @relation("ClosedTickets")
  qaReviews          QAReview[]
  ticketComments     TicketComment[]
  ticketEvents       TicketEvent[]
  ticketAttachments  TicketAttachment[]
}

model Building {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  country     String
  totalArea   Float
  floors      Int
  yearBuilt   Int
  imageUrl    String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())

  spaces       Space[]
  assets       Asset[]
  leases       Lease[]
  digitalTwins DigitalTwin[]
  bimModels    BIMModel[]
  tickets      Ticket[]
}

model Space {
  id         String   @id @default(uuid())
  name       String
  type       String   // office, meeting-room, common-area, storage
  floor      Int
  area       Float
  capacity   Int
  occupancy  Int      @default(0)
  status     String   @default("available") // available, occupied, maintenance
  price      Float?
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  reservations Reservation[]
}

model Asset {
  id              String      @id @default(uuid())
  name            String
  category        String      // HVAC, electrical, furniture, IT, security
  model           String?
  serialNumber    String      @unique
  manufacturer    String?
  purchaseDate    DateTime
  purchasePrice   Float
  warrantyEnd     DateTime?
  location        String
  status          String      @default("OPERATIONAL")
  healthScore     Int         @default(100) // 0-100
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  buildingId      String
  building        Building    @relation(fields: [buildingId], references: [id])
  managerId       String?
  manager         User?       @relation(fields: [managerId], references: [id])
  tenantId        String?
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])

  workOrders      WorkOrder[]
  sensors         Sensor[]
  maintenanceLogs MaintenanceLog[]
  procedures      Procedure[]
  digitalTwins    DigitalTwin[]
  bimElements     BIMElement[]
  erpAssetMappings ERPAssetMapping[]
  tickets         Ticket[]
  assetQRCodes    AssetQRCode[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Sensor {
  id        String   @id @default(uuid())
  type      String   // temperature, humidity, energy, vibration
  value     Float
  unit      String
  status    String   @default("active")
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings  SensorReading[]
  createdAt DateTime @default(now())
}

model SensorReading {
  id        String   @id @default(uuid())
  value     Float
  timestamp DateTime @default(now())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id            String    @id @default(uuid())
  title         String
  description   String
  type          String
  priority      String    @default("MEDIUM")
  status        String    @default("PENDING")
  estimatedCost Float?
  actualCost    Float?
  scheduledAt   DateTime
  completedAt   DateTime?

  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id])

  assignedToId  String?
  assignedTo    User?     @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById   String
  createdBy     User      @relation("CreatedBy", fields: [createdById], references: [id])

  comments      Comment[]
  orderParts    WorkOrderPart[]
  tickets       Ticket[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Comment {
  id          String    @id @default(uuid())
  content     String
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
}

model MaintenanceLog {
  id          String   @id @default(uuid())
  description String
  cost        Float
  performedAt DateTime
  performedBy String
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Lease {
  id          String   @id @default(uuid())
  tenant      String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Float
  deposit     Float
  status      String   @default("active")
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  createdAt   DateTime @default(now())
}

model Reservation {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  purpose   String
  userId    String?
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model EnergyConsumption {
  id         String   @id @default(uuid())
  buildingId String
  type       String   // electricity, gas, water
  value      Float
  unit       String
  cost       Float
  period     DateTime
  createdAt  DateTime @default(now())
}

// ============== AUDIT TRAIL ==============
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // ex: CREATE_ASSET, DELETE_WORK_ORDER
  entity    String   // ex: ASSET, WORK_ORDER
  entityId  String?
  ipAddress String?
  details   String?  // JSON string
  timestamp DateTime @default(now())
}

// ============== CMMS / GMAO ==============
model Part {
  id          String   @id @default(uuid())
  partNumber  String   @unique
  name        String
  category    String
  description String?
  unit        String   @default("unit")
  unitCost    Float
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  maxQuantity Int      @default(100)
  location    String?
  supplier    String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  movements   InventoryMovement[]
  orderParts  WorkOrderPart[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryMovement {
  id        String   @id @default(uuid())
  type      String   // IN, OUT, ADJUSTMENT, RETURN
  quantity  Int
  reason    String
  reference String?
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id])
  quantity    Int
  unitCost    Float
}

model Procedure {
  id            String   @id @default(uuid())
  title         String
  category      String
  steps         String   // Array of {order, action, duration, tools[]} as JSON string
  estimatedTime Int      // minutes
  safetyNotes   String?
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id])
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model FailureCode {
  id          String   @id @default(uuid())
  code        String
  description String
  category    String
  severity    String
  resolution  String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

// ============== DIGITAL TWIN ==============
model DigitalTwin {
  id          String   @id @default(uuid())
  name        String
  type        String   // BUILDING, FLOOR, ASSET
  modelUrl    String?  // 3D model URL
  metadata    String   // JSON string
  position    String?  // JSON string {x, y, z}
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id])
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  snapshots   TwinSnapshot[]
  simulations TwinSimulation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TwinSnapshot {
  id        String      @id @default(uuid())
  twinId    String
  twin      DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  data      String      // JSON string {temperature, energy, occupancy, etc}
  thumbnail String?
  createdAt DateTime    @default(now())
}

model TwinSimulation {
  id         String      @id @default(uuid())
  twinId     String
  twin       DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  scenario   String      // 'fire', 'evacuation', 'energy_optim', 'maintenance'
  parameters String      // JSON string
  results    String      // JSON string
  duration   Int         // minutes simulated
  createdAt  DateTime    @default(now())
}

// ============== NOTIFICATIONS PUSH ==============
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  type      String    // WORK_ORDER, ASSET, SENSOR, LEASE, INVENTORY
  title     String
  body      String
  data      String?   // JSON string
  priority  String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  read      Boolean   @default(false)
  readAt    DateTime?
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt DateTime  @default(now())
}

model NotificationPreference {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrderAssigned  Boolean @default(true)
  workOrderCompleted Boolean @default(false)
  assetAlerts        Boolean @default(true)
  sensorAlerts       Boolean @default(true)
  leaseExpiring      Boolean @default(true)
  inventoryLow       Boolean @default(true)
  emailEnabled       Boolean @default(true)
  pushEnabled        Boolean @default(true)
  smsEnabled         Boolean @default(false)
  quietHoursStart    Int?    // 22
  quietHoursEnd      Int?    // 7
}

// ============== ERP INTEGRATION ==============
model ERPConnection {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  type           String        // SAP, ORACLE, DYNAMICS, ODOO, GENERIC
  status         String        @default("INACTIVE") // ACTIVE, INACTIVE, ERROR

  // Configuration
  baseUrl        String
  apiVersion     String?
  clientId       String?
  clientSecret   String?       // chiffre
  username       String?
  password       String?       // chiffre
  apiKey         String?
  companyCode    String?
  plantCode      String?

  // Mapping
  entityMapping  String        // Mapping champs CAFM   ERP (JSON string)

  // Sync config
  syncAssets     Boolean       @default(true)
  syncWorkOrders Boolean       @default(true)
  syncInvoices   Boolean       @default(false)
  syncInterval   Int           @default(60) // minutes

  lastSyncAt     DateTime?
  lastError      String?
  totalSynced    Int           @default(0)

  syncLogs       ERPSyncLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ERPSyncLog {
  id               String        @id @default(uuid())
  connectionId     String
  connection       ERPConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type             String        // ASSET_PULL, WO_PUSH, INVOICE_PULL, etc.
  status           String        // SUCCESS, PARTIAL, FAILED
  recordsProcessed Int           @default(0)
  recordsCreated   Int           @default(0)
  recordsUpdated   Int           @default(0)
  recordsFailed    Int           @default(0)
  errors           String?       // JSON string
  duration         Int           // ms
  startedAt        DateTime
  completedAt      DateTime?
  triggeredBy      String?       // 'SCHEDULED', 'MANUAL', 'WEBHOOK'
  createdAt        DateTime      @default(now())
}

model ERPAssetMapping {
  id               String    @id @default(uuid())
  connectionId     String
  cafmAssetId      String
  cafmAsset        Asset     @relation(fields: [cafmAssetId], references: [id], onDelete: Cascade)
  erpAssetId       String
  erpAssetType     String?
  lastSyncedAt     DateTime?
  syncDirection    String    @default("BIDIRECTIONAL") // PULL, PUSH, BIDIRECTIONAL
  conflictStrategy String    @default("LATEST_WINS") // LATEST_WINS, ERP_WINS, CAFM_WINS, MANUAL
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ERPInvoice {
  id            String    @id @default(uuid())
  connectionId  String
  invoiceNumber String
  vendor        String
  amount        Float
  currency      String    @default("EUR")
  invoiceDate   DateTime
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  poNumber      String?
  workOrderId   String?
  attachments   String?   // JSON string
  syncedAt      DateTime  @default(now())

  @@unique([connectionId, invoiceNumber])
}

// ============== BIM (BUILDING INFORMATION MODELING) ==============
model BIMModel {
  id          String       @id @default(uuid())
  name        String
  fileUrl     String
  version     Int          @default(1)
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  elements    BIMElement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BIMElement {
  id         String        @id @default(uuid())
  modelId    String
  model      BIMModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  ifcId      String        // GlobalId dans le fichier IFC
  name       String
  type       String        // IfcWall, IfcWindow, IfcDoor, IfcFlowTerminal, etc.
  spaceId    String?
  assetId    String?
  asset      Asset?        @relation(fields: [assetId], references: [id])
  properties BIMProperty[]
  createdAt  DateTime      @default(now())
}

model BIMProperty {
  id        String     @id @default(uuid())
  elementId String
  element   BIMElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  set       String     // ex: Pset_WallCommon
  name      String     // ex: LoadBearing
  value     String     // valeur stockee en chaine
}


// ============== CRM SAAS ==============

model CRMOrganization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  industry    String?
  size        String?  // 1-10, 11-50, 51-200, 200+
  logoUrl     String?
  website     String?
  plan        String   @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxUsers    Int      @default(1)
  maxContacts Int      @default(100)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       CRMUser[]
  contacts    CRMContact[]
  deals       CRMDeal[]
  activityLogs CRMActivityLog[]
  customFields CRMCustomField[]
  importJobs  CRMImportJob[]
}

model CRMUser {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  firstName       String
  lastName        String
  role            String   @default("OWNER") // OWNER, ADMIN, MEMBER, VIEWER
  companyName     String?
  jobTitle        String?
  avatar          String?
  phone           String?
  emailVerified   Boolean  @default(false)
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  plan            String   @default("FREE")
  trialEndsAt     DateTime?
  subscriptionId  String?

  // ─── Stripe ───────────────────────────────────────────────────
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?  @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED, PAUSED

  organizationId  String
  organization    CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        CRMContact[]
  deals           CRMDeal[]
  activities      CRMActivity[]
  activityLogs    CRMActivityLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CRMContact {
  id             String   @id @default(uuid())
  organizationId String
  organization   CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  mobile         String?
  company        String?
  jobTitle       String?
  department     String?
  industry       String?
  companySize    String?
  website        String?
  address        String?
  city           String?
  postalCode     String?
  country        String?
  linkedin       String?
  twitter        String?
  type           String   @default("LEAD") // LEAD, PROSPECT, CUSTOMER, PARTNER, VENDOR
  source         String?
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  rating         Int?
  tags           String?  // Stored as JSON string for SQLite
  ownerId        String
  owner          CRMUser  @relation(fields: [ownerId], references: [id])
  deals          CRMDeal[]
  activities     CRMActivity[]
  lastContactedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CRMDeal {
  id                String   @id @default(uuid())
  organizationId    String
  organization      CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  amount            Float    @default(0)
  currency          String   @default("EUR")
  status            String   @default("PIPELINE") // PIPELINE, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  stage             String   @default("Pipeline")
  probability       Int      @default(10)
  expectedCloseDate DateTime
  closedAt          DateTime?
  source            String?
  campaign          String?
  description       String?
  nextStep          String?
  lostReason        String?
  tags              String?  // JSON string for SQLite
  contactId         String
  contact           CRMContact @relation(fields: [contactId], references: [id])
  ownerId           String
  owner             CRMUser  @relation(fields: [ownerId], references: [id])
  activities        CRMActivity[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CRMActivity {
  id             String   @id @default(uuid())
  organizationId String
  type           String   // CALL, EMAIL, MEETING, NOTE, TASK
  subject        String
  description    String?
  contactId      String?
  contact        CRMContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           CRMDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId         String
  user           CRMUser     @relation(fields: [userId], references: [id])
  completedAt    DateTime?
  createdAt      DateTime @default(now())
}

model CRMActivityLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           CRMUser? @relation(fields: [userId], references: [id])
  action         String   // CREATE, UPDATE, DELETE, LOGIN
  entity         String
  entityId       String?
  metadata       String?  // JSON string for SQLite
  createdAt      DateTime @default(now())
}

model CRMCustomField {
  id             String   @id @default(uuid())
  organizationId String
  organization   CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String   // 'contact', 'deal'
  name           String
  label          String
  type           String   // text, number, date, select, multiselect, boolean
  options        String?  // JSON array string for SQLite
  required       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model CRMImportJob {
  id             String   @id @default(uuid())
  organizationId String
  organization   CRMOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String   // 'contacts', 'deals'
  status         String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows      Int      @default(0)
  processed      Int      @default(0)
  succeeded      Int      @default(0)
  failed         Int      @default(0)
  errors         String?  // JSON string for SQLite
  fileName       String
  userId         String
  completedAt    DateTime?
  createdAt      DateTime @default(now())
}

// ============================================
// TICKETS / RECLAMATIONS
// ============================================

enum TicketSeverity {
  LOW           // Panne non-urgente
  MEDIUM        // Gêne modérée
  HIGH          // Impact significatif
  CRITICAL      // Risque sécurité/santé
  EMERGENCY     // Danger immédiat
}

enum TicketStatus {
  DRAFT         // Brouillon non soumis
  SUBMITTED     // Soumis, en attente triage
  TRIAGED       // Validé par FM, prêt dispatch
  ASSIGNED      // Assigné technicien
  IN_PROGRESS   // Intervention en cours
  TECH_CLOSED   // Clôture technique, attente QA
  QAP_PASSED    // Validation QA réussie
  QAP_REJECTED  // Rejet QA, retour tech
  CLOSED        // Clôture définitive (signée)
  CANCELLED     // Annulé
}

enum TicketCategory {
  PLUMBING          // Plomberie
  ELECTRICAL        // Électricité
  HVAC              // CVC / Climatisation
  CARPENTRY         // Menuiserie
  CLEANING          // Nettoyage
  PEST_CONTROL      // Nuisibles
  SECURITY          // Sécurité
  IT_NETWORK        // Réseau IT
  LIGHTING          // Éclairage
  ACCESS            // Contrôle d'accès
  NOISE             // Nuisance sonore
  TEMPERATURE       // Confort thermique
  SAFETY            // Sécurité incendie/sûreté
  OTHER             // Autre
}

model Ticket {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Identifiants humains
  reference       String   // ex: "TKT-2026-00001" (lisible)
  title           String
  description     String
  category        TicketCategory
  subcategory     String?
  severity        TicketSeverity @default(MEDIUM)
  status          TicketStatus @default(SUBMITTED)
  
  // Localisation
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id])
  floor           String?
  zone            String?
  locationDetails String?  // Description libre de l'emplacement
  geoLocation     String?  // JSON string: {lat, lng}
  
  // Lien vers asset BIM (optionnel)
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id])
  
  // Workflow
  submittedById   String?  // null si anonyme
  submittedBy     User?    @relation("SubmittedTickets", fields: [submittedById], references: [id])
  submittedByName String?  // Pour les soumissions anonymes
  submittedByContact String? // Email ou téléphone si pas de user
  submissionSource TicketSubmissionSource @default(WEB)
  
  validatedById   String?
  validatedBy     User?    @relation("ValidatedTickets", fields: [validatedById], references: [id])
  validatedAt     DateTime?
  
  assignedToId    String?
  assignedTo      User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedAt      DateTime?
  
  closedById      String?
  closedBy        User?    @relation("ClosedTickets", fields: [closedById], references: [id])
  closedAt        DateTime?
  closureReason   String?
  
  // Lien Work Order
  workOrderId     String?
  workOrder       WorkOrder? @relation(fields: [workOrderId], references: [id])
  
  // SLA
  slaPolicyId     String?
  slaPolicy       SLAPolicy? @relation(fields: [slaPolicyId], references: [id])
  slaResponseDueAt   DateTime?
  slaResolutionDueAt DateTime?
  slaResponseMetAt   DateTime?
  slaResolutionMetAt DateTime?
  slaBreached      Boolean @default(false)
  
  // Satisfaction (post-clôture)
  satisfactionRating Int?   // 1-5
  satisfactionComment String?
  satisfactionAt    DateTime?
  
  // Métadonnées
  attachments     TicketAttachment[]
  events          TicketEvent[]
  comments        TicketComment[]
  qaReviews       QAReview[]
  
  tags            String?  // JSON string or CSV
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([assignedToId, status])
  @@index([buildingId])
  @@index([assetId])
  @@index([slaResolutionDueAt, status])
  @@index([submittedById])
  @@index([createdAt])
  @@index([deletedAt])
}

enum TicketSubmissionSource {
  WEB
  MOBILE_APP
  EMAIL
  PHONE
  QR_CODE
  CHATBOT
  IOT_SENSOR
  API
  IMPORT
}

model TicketAttachment {
  id            String   @id @default(uuid())
  tenantId      String
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  
  filename      String
  storageKey    String   // S3 key
  mimeType      String
  sizeBytes     Int
  category      AttachmentCategory @default(GENERAL)
  capturedAt    DateTime?
  geoLocation   String?  // JSON string
  metadata      String?  // JSON string
  
  createdAt     DateTime @default(now())
  
  @@index([tenantId, ticketId])
}

enum AttachmentCategory {
  BEFORE_PHOTO
  AFTER_PHOTO
  DIAGNOSTIC_PHOTO
  SIGNATURE
  INVOICE
  REPORT
  GENERAL
}

model TicketEvent {
  id          String   @id @default(uuid())
  tenantId    String
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  type        TicketEventType
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  
  metadata    String?  // JSON string
  comment     String?
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId, ticketId, createdAt])
  @@index([type])
}

enum TicketEventType {
  CREATED
  SUBMITTED
  VALIDATED
  SEVERITY_CHANGED
  ASSIGNED
  REASSIGNED
  WORK_ORDER_LINKED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  SLA_BREACHED_WARNING
  SLA_BREACHED
  TECHNICIAN_STARTED
  TECHNICIAN_COMPLETED
  QA_REVIEW_STARTED
  QA_APPROVED
  QA_REJECTED
  CLOSED
  REOPENED
  CANCELLED
  SATISFACTION_RECEIVED
  ESCALATED
}

model TicketComment {
  id          String   @id @default(uuid())
  tenantId    String
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  authorName  String?  // Pour commentaires externes
  isInternal  Boolean  @default(false) // Visible uniquement staff
  visibility  CommentVisibility @default(ALL)
  content     String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  @@index([tenantId, ticketId, createdAt])
}

enum CommentVisibility {
  ALL              // Demandeur, FM, Tech, QA
  STAFF_ONLY       // FM, Tech, QA (pas le demandeur)
  INTERNAL_NOTES   // Notes internes uniquement
  SUPERVISORS      // FM + superviseurs
}

// ============================================
// QA (Quality Assurance)
// ============================================

model QAReview {
  id              String   @id @default(uuid())
  tenantId        String
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [id])
  
  // Critères d'évaluation (extensible)
  criteriaScores  String   // JSON string: {technical: 4, cleanliness: 5, ...}
  totalScore      Float
  passed          Boolean
  
  rejectionReasons String?  // JSON string array or text
  comments        String?
  
  reviewedAt      DateTime @default(now())
  
  attachments     QAReviewAttachment[]
  
  @@index([tenantId, ticketId])
  @@index([reviewerId])
  @@index([passed])
}

model QAReviewAttachment {
  id          String   @id @default(uuid())
  qaReviewId  String
  qaReview    QAReview @relation(fields: [qaReviewId], references: [id], onDelete: Cascade)
  storageKey  String
  filename    String
  mimeType    String
  createdAt   DateTime @default(now())
}

// ============================================
// SLA POLICIES
// ============================================

model SLAPolicy {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  
  // Cible SLA par sévérité (en minutes)
  category        TicketCategory?
  severity        TicketSeverity?
  priority        Int      @default(0) // Plus haut = prioritaire
  
  responseTimeMinutes    Int   // Temps cible avant première action
  resolutionTimeMinutes  Int   // Temps cible résolution complète
  
  // Escalade
  escalateAfterMinutes   Int?
  escalateToRole         String?
  escalateToUserId       String?
  
  // Heures ouvrées
  businessHoursOnly      Boolean @default(false)
  businessHoursConfig    String? // JSON string: {mon: {start: '08:00', end: '18:00'}, ...}
  
  isActive       Boolean  @default(true)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  tickets        Ticket[]
  
  @@index([tenantId, isActive])
  @@index([category, severity])
}

model SLAEscalation {
  id          String   @id @default(uuid())
  tenantId    String
  ticketId    String
  level       Int      // 1, 2, 3...
  
  reason      String
  escalatedToId String
  escalatedAt DateTime @default(now())
  
  @@index([tenantId, ticketId])
  @@index([escalatedAt])
}

// ============================================
// QR CODES & ASSET LINKS
// ============================================

model AssetQRCode {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId            String
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  shortCode          String   @unique // 8+ caractères alphanum
  qrUrl              String?  // URL signée
  signedPayload      String?  // Payload cryptographique
  format             String   @default("QR_HIGH")
  
  // Stats
  scanCount          Int      @default(0)
  firstScannedAt     DateTime?
  lastScannedAt      DateTime?
  
  isActive           Boolean  @default(true)
  
  // Gestion cycle de vie
  generatedBy        String?
  generatedAt        DateTime @default(now())
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  
  scans              QRScanEvent[]
  batches            QRBatchJob[]
  
  @@index([tenantId, assetId])
  @@index([shortCode])
  @@index([isActive])
}

model QRScanEvent {
  id              String   @id @default(uuid())
  tenantId        String
  assetId         String?
  shortCode       String
  qrCodeId        String?
  qrCode          AssetQRCode? @relation(fields: [qrCodeId], references: [id])
  
  // Source tracking (RGPD-friendly)
  ipAddress       String?
  country         String?
  city            String?
  deviceType      String?  // mobile, tablet, desktop
  os              String?
  browser         String?
  referer         String?
  userAgent       String?
  geoLocation     String?  // JSON string: {lat, lng, accuracy}
  
  // Outcome
  resultStatus    String?  // success, expired, invalid_signature
  ticketCreatedId String?  // Le ticket créé suite au scan
  ticketCreated   Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  
  @@index([tenantId, createdAt])
  @@index([assetId, createdAt])
  @@index([shortCode])
}

model QRBatchJob {
  id            String   @id @default(uuid())
  tenantId      String
  generatedBy   String?
  qrCodeId      String?
  qrCode        AssetQRCode? @relation(fields: [qrCodeId], references: [id])
  
  assetCount    Int
  format        String
  layout        String
  pdfStorageKey String?
  
  createdAt     DateTime @default(now())
  
  @@index([tenantId, createdAt])
}

